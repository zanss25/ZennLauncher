<UserControl x:Name="RootGamesView" x:Class="ZennLauncherApp.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZennLauncherApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="NoAppsAvailable" Visibility="Hidden"
                Grid.Row="1" VerticalAlignment="Top"
                Height="50" Width="Auto" MaxWidth="600" Margin="0,100"
                CornerRadius="5" BorderThickness="1">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0019171f" Offset="0"/>
                    <GradientStop Color="#0019171f" Offset="0.1"/>
                    <GradientStop Color="#FF19171f" Offset="0.4"/>
                    <GradientStop Color="#FF19171f" Offset="0.6"/>
                    <GradientStop Color="#0019171f" Offset="0.9"/>
                    <GradientStop Color="#0019171f" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00342D47" Offset="0"/>
                    <GradientStop Color="#00342D47" Offset="0.1"/>
                    <GradientStop Color="#DD453C5F" Offset="0.5"/>
                    <GradientStop Color="#00342D47" Offset="0.9"/>
                    <GradientStop Color="#00342D47" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <TextBlock Text="✖   No games found" FontSize="14" FontWeight="Regular"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{StaticResource FontCommon}" Foreground="#70F5F5F5"/>
        </Border>

        <ScrollViewer x:Name="ContentViewer" Grid.RowSpan="2" 
                      VerticalScrollBarVisibility="Auto">

            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SimpleScrollBarEdge}"/>
            </ScrollViewer.Resources>
        
            <Grid Margin="40,90,20,68" HorizontalAlignment="Left">
                <ItemsControl x:Name="ContainerBtnApps" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8" HorizontalAlignment="Stretch">
                                <Viewbox Width="140" Stretch="Uniform">
                                    <Button Width="149" Height="223" 
                                            BorderBrush="#00000000"
                                            Style="{StaticResource CoverButtonStyle}"
                                            MouseDoubleClick="BtnApps_MouseDoubleClick"
                                            Tag="{Binding}"
                                            Cursor="Hand">

                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource ContextMenuStyle}">

                                                <MenuItem x:Name="MenuItemLaunch"
                                                          Header="LAUNCH" 
                                                          Click="MenuItemLaunch_Click"
                                                          Tag="{Binding}"
                                                          Style="{StaticResource ContextMenuItemStyle_Primary}"
                                                          TextBlock.FontWeight="DemiBold"/>
                                             
                                                <MenuItem x:Name="MenuOpenDir"
                                                          Header="Open File Location" 
                                                          Click="MenuOpenDir_Click"
                                                          Tag="{Binding}"
                                                          Style="{StaticResource ContextMenuItemStyle_Common}"/>

                                                <MenuItem x:Name="MenuItemEdit"
                                                          Header="Game Properties" 
                                                          Click="MenuItemEdit_Click"
                                                          Tag="{Binding}"
                                                          Style="{StaticResource ContextMenuItemStyle_Common}"/>
                                                
                                                <Separator Style="{StaticResource ContextMenuSeparatorStyle}"/>

                                                <MenuItem x:Name="MenuItemDelete"
                                                          Header="Delete Game" 
                                                          Click="MenuItemDelete_Click" 
                                                          Tag="{Binding}"
                                                          Style="{StaticResource ContextMenuItemStyle_Common}"/>

                                            </ContextMenu>
                                        </Button.ContextMenu>

                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                                <Image Source="{Binding GameIconPath, Converter={StaticResource ImageConverter}, ConverterParameter=112}" 
                                                       Width="92" 
                                                       Height="92" />

                                                <TextBlock Text="{Binding GameTitle}"
                                                           FontSize="12"
                                                           Margin="10"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextCommonActiveBrush}" />

                                            </StackPanel>

                                            <Image Source="{Binding GameCoverPath, Converter={StaticResource ImageConverter}, ConverterParameter=253}" 
                                                   Width="149" 
                                                   Height="223" 
                                                   Stretch="UniformToFill"/>
                                        </Grid>
                                    </Button>
                                </Viewbox>
                                
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <DockPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.Row="0" MinHeight="70" 
                   MaxHeight="100" Margin="0,-2,0,0" IsHitTestVisible="False">

            <DockPanel.Effect>
                <BlurEffect/>
            </DockPanel.Effect>

            <DockPanel.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#00161616" Offset="1"/>
                    <GradientStop Color="{StaticResource BarBackGradient}" 
                                  Offset="0"/>
                </LinearGradientBrush>
            </DockPanel.Background>

        </DockPanel>

        <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.Row="0" 
                MinHeight="43" MaxHeight="100" Margin="32,18,32,10" CornerRadius="6" 
                Background="{StaticResource BarBackgroundBrush}" BorderThickness="0.5" 
                BorderBrush="{StaticResource BarBorderBrush}">

            <DockPanel>

                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" 
                            MinHeight="30" Margin="0,0.3">
                    <Grid>
                        <TextBox  x:Name="SearchBar" 
                                  TextChanged="SearchBar_Changed" 
                                  MinWidth="280"
                                  MaxWidth="280"
                                  VerticalContentAlignment="Center" 
                                  MinHeight="25"
                                  Margin="10,6,12,6" 
                                  Padding="5,0,0,0"
                                  Style="{StaticResource TextBoxStyle}"/>

                        <TextBlock IsHitTestVisible="False" 
                                   Text="🔍  Search games" 
                                   FontFamily="{StaticResource FontCommon}"
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Left" 
                                   Margin="20,0,0,0" 
                                   Foreground="#30FFFFFF">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBar}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>
                    </Grid>
                </StackPanel>

                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="1,0.5">

                    <ComboBox x:Name="ComboCategories" 
                              Width="230" MinWidth="125" MaxWidth="250" Margin="0,7,10,7" 
                              Style="{StaticResource ComboBoxStyle}"
                              SelectionChanged="ComboCategories_Changed"
                              PreviewMouseWheel="ComboBox_PreviewMouseWheel"
                              SelectedIndex="0" MinHeight="25">

                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}">
                                
                            </Style>
                        </ComboBox.ItemContainerStyle>

                    </ComboBox>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="1,0.5">

                    <TextBlock Text="Sort by" Margin="10,10,0,10"
                               FontFamily="{StaticResource FontCommon}" Foreground="#66FFFFFF" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <ComboBox x:Name="ComboSortBy" 
                              MinWidth="135" Margin="10,7,10,7" 
                              Style="{StaticResource ComboBoxStyle}"
                              SelectionChanged="ComboSortBy_Changed"
                              PreviewMouseWheel="ComboBox_PreviewMouseWheel"
                              SelectedIndex="0" MinHeight="25">

                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}">
                                <Setter Property="Tag" Value="{Binding SortByTag}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>

                    </ComboBox>
                </StackPanel>

            </DockPanel>
        </Border>
    </Grid>
</UserControl>
