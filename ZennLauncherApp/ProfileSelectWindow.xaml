<Window x:Class="ZennLauncherApp.ProfileSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZennLauncherApp"
        mc:Ignorable="d"
        Title="Profile Selection" 
        Height="400" Width="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      GlassFrameThickness="5"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <local:ProfileImageConverter x:Key="ProfileImgConv"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CustomResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF1A1820"/>
            <GradientStop Color="#FF18161F" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Border BorderThickness="2, 40, 2, 2">
        <Border.BorderBrush>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <LinearGradientBrush.RelativeTransform>
                    <TransformGroup>
                        <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                        <SkewTransform CenterX="0.5" CenterY="0.5"/>
                        <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#FF2A243B"/>
                <GradientStop Color="#FF2E2741" Offset="0.5"/>
                <GradientStop Color="#FF2A243B" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>


        <Grid x:Name="MainGrid" Margin="5,0,5,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="100" MaxWidth="212"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.Effect>
                <BlurEffect Radius="0"/>
            </Grid.Effect>

            <StackPanel Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource WindowControlButtonAreaStyle}">

                <Button Content="—" Click="BtnMinimize_Click" Style="{StaticResource ControlButtonStyle}"
                        MinWidth="35" MinHeight="30" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="✕" Click="BtnClose_Click" Style="{StaticResource ControlButtonStyle}"
                        MinWidth="35" MinHeight="30" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="0"
                        Margin="32,-40,0,0" WindowChrome.IsHitTestVisibleInChrome="False" 
                        HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="0"
                        MinWidth="55" MinHeight="40">

                <TextBlock Text="ZENN" FontWeight="Bold" 
                           VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                           FontSize="17" Margin="0,0,0,5">
                    
                    <TextBlock.Foreground>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#A89083B3"/>
                            <GradientStop Color="#A8B6A0ED" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    
                </TextBlock>

            </StackPanel>

            <StackPanel x:Name="EmptyProfileWelcome" Visibility="Hidden"
                        Grid.ColumnSpan="2" Grid.RowSpan="2" 
                        VerticalAlignment="Top" Margin="0,80">
                
                <TextBlock Text="Welcome, Player.." 
                           Margin="25"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="25" Foreground="#FFF5F5F5" FontWeight="DemiBold"/>

                <Button x:Name="BtnCreateNewProfile_Empty" Content="Create New Profile" Grid.Row="0"
                        Click="BtnCreateNewProfile_Click" Style="{StaticResource MenuButtonStyle_PrimaryA}"
                        Margin="0,5" Padding="15,8,15,8" MinWidth="125" MaxWidth="200" 
                        FontFamily="Global Sans Serif" FontSize="12" 
                        BorderThickness="0,0,0,0" VerticalAlignment="Bottom"/>
            </StackPanel>

            <Grid Margin="10,0,10,0" Grid.Row="0" Grid.Column="0">

                <ListBox x:Name="SidebarProfilesList"
                         SelectionChanged="SidebarProfilesList_SelectionChanged"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                         Style="{StaticResource ListBoxStyle}"
                         ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                         FontFamily="Segoe UI" FontSize="14" FontWeight="Regular" Margin="0,15"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0">
                                <Border x:Name="ProfileAvatar"
                                        Width="40"
                                        Height="40"
                                        BorderBrush="#70594D7B"
                                        BorderThickness="1.5"
                                        Margin="0,0,10,0">
                                    <Border.Background>
                                        <ImageBrush>
                                            <ImageBrush.ImageSource>
                                                <Binding Path="ProfileId"  
                                                                Converter="{StaticResource ProfileImgConv}"                    
                                                                ConverterParameter="42">
                                                    <Binding.TargetNullValue>
                                                        <BitmapImage UriSource="/default_avatar.jpg"
                                                                     DecodePixelWidth="42"
                                                                     CacheOption="OnLoad"/>
                                                    </Binding.TargetNullValue>
                                                </Binding>
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>

                                <TextBlock Text="{Binding ProfileName}" 
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI" FontSize="13"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

            <StackPanel Margin="10,0" Grid.Column="0" Grid.Row="1">

                <DockPanel Margin="0,0,0,25">
                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="BtnCreateNewProfile" Content="Create New Profile" Grid.Row="0"
                                Click="BtnCreateNewProfile_Click" Style="{StaticResource MenuButtonStyle_PrimaryB}"
                                Margin="0,5" Padding="15,8,15,8" MinWidth="125" FontFamily="Global Sans Serif" 
                                FontSize="12" BorderThickness="0,0,0,0" VerticalAlignment="Bottom"/>

                    </Grid>
                    
                </DockPanel>
            </StackPanel>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                       Grid.Column="1" Grid.RowSpan="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="ProfileAvatar" Visibility="Collapsed"
                        Grid.ColumnSpan="2" Grid.Row="0"
                        Width="160" Height="160"
                        BorderBrush="#70594D7B"
                        BorderThickness="2"
                        Margin="15">
                    <Border.Background>
                        <ImageBrush>
                            <ImageBrush.ImageSource>
                                <Binding Path="SelectedItem.ProfileId" ElementName="SidebarProfilesList" 
                                         Converter="{StaticResource ProfileImgConv}"
                                         ConverterParameter="170">
                                    <Binding.TargetNullValue>
                                        <BitmapImage UriSource="/default_avatar.jpg"
                                                     DecodePixelWidth="170"
                                                     CacheOption="OnLoad"/>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, 
                                                        ElementName=SidebarProfilesList}" 
                                             Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                </Border>

                <TextBlock Text="{Binding SelectedItem.ProfileName, 
                                    ElementName=SidebarProfilesList, 
                                    FallbackValue=''}" Visibility="Collapsed"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Grid.ColumnSpan="2" Grid.Row="1" Margin="0,10,0,25"
                           Foreground="#B2FFFFFF"
                           FontFamily="Segoe UI" FontSize="25" FontWeight="Bold"/>

                <Grid Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, 
                                                        ElementName=SidebarProfilesList}" 
                                                        Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <DockPanel LastChildFill="True" HorizontalAlignment="Stretch">
                        <PasswordBox Name="InputProfilePass"
                                     PasswordChar="●"
                                     Grid.Column="0" Grid.Row="0"
                                     Height="30" Width="200"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Padding="5,0,0,0">

                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource PasswordBoxStyleB}">
                                    <Setter Property="Visibility" Value="Visible"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.ProfileHash, 
                                                                ElementName=SidebarProfilesList}" 
                                                                Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding SelectedItem, 
                                                                ElementName=SidebarProfilesList}" 
                                                                Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>

                        </PasswordBox>

                        <Button x:Name="BtnLogIn" Content="Sign in" Grid.Column="1" Grid.Row="0"
                                Click="BtnLogIn_Click" Style="{StaticResource MenuButtonStyle_PrimaryA}" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Margin="5,0,0,0" Padding="15,8,15,8" MinWidth="30"
                                FontFamily="Global Sans Serif" FontSize="12" BorderBrush="#FF594D7B" 
                                BorderThickness="0,0,0,0" VerticalAlignment="Center"
                                IsDefault="True"/>
                    </DockPanel>

                    <CheckBox x:Name="CheckBoxKeepLoggedIn" Content="Remember me"
                              Style="{StaticResource CheckBoxStyle}"
                              Grid.Row="1" Margin="0,20" Foreground="#CCFFFFFF"/>

                </Grid>

            </Grid>

            <Border x:Name="BlackOverlay" Grid.ColumnSpan="4" Grid.RowSpan="3" Background="#00000000"
                    Margin="-5,-39,-5,-5" IsHitTestVisible="False"/>

        </Grid>
    </Border>
</Window>
