<UserControl x:Class="ZennLauncherApp.InterfaceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZennLauncherApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CustomResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ContentViewer" Grid.Row="1" HorizontalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">

            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SimpleScrollBarEdge}"/>
            </ScrollViewer.Resources>

            <StackPanel Margin="20,5">

                <ItemsControl x:Name="ContainerInterfaceSettings">
                    
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <Grid Grid.Row="0" MinHeight="70" VerticalAlignment="Top">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Appearance"
                                   Grid.Column="1" Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Foreground="WhiteSmoke"
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Left"/>

                    </Grid>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13">
                        <Grid HorizontalAlignment="Stretch">
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Backdrop Effects" Grid.Column="0" 
                                           VerticalAlignment="Center" Foreground="#BBFFFFFF"/>

                            <TextBlock Text="Set the visual style of the background overlay for windows and popups" Grid.Column="1"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                           Margin="15,0" Foreground="#55FFFFFF"/>

                            <ComboBox x:Name="ComboDialogOverlay"
                                          MinWidth="125" Grid.Column="2"
                                          MinHeight="30" Padding="10,8"
                                          Style="{StaticResource ComboBoxStyleB}"
                                          SelectionChanged="ComboDialogOverlay_Changed"
                                          HorizontalAlignment="Right">

                                <ComboBoxItem Content="Acrylic Blur" Tag="DimWithBlur"/>
                                <ComboBoxItem Content="Dim Background" Tag="DimOnly"/>
                                <ComboBoxItem Content="No Effects" Tag="None"/>

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyleB}">
                                        <Setter Property="Tag" Value="{Binding ItemTag}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                            </ComboBox>
                        </Grid>
                    </Border>

                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
