<UserControl x:Class="ZennLauncherApp.InterfaceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZennLauncherApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ContentViewer" Grid.Row="1" HorizontalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">

            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SimpleScrollBarEdge}"/>
            </ScrollViewer.Resources>

            <StackPanel Margin="20,5">

                <ItemsControl x:Name="ContainerInterfaceSettings">
                    
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <Grid Grid.Row="0" MinHeight="70" VerticalAlignment="Top">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Appearance"
                                   Grid.Column="1" Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SettingsTitleText}"
                                   HorizontalAlignment="Left"/>

                    </Grid>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13">
                        <Grid HorizontalAlignment="Stretch">
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Backdrop Effects" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Style="{StaticResource OptionNameText}"/>

                            <TextBlock Text="Set the visual style of the background overlay for windows and popups" 
                                       Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Margin="15,0" Style="{StaticResource OptionDescText}"/>

                            <ComboBox x:Name="ComboDialogOverlay"
                                          MinWidth="125" Grid.Column="2"
                                          MinHeight="30" Padding="10,8"
                                          Style="{StaticResource ComboBoxStyle}"
                                          SelectionChanged="ComboDialogOverlay_Changed"
                                          HorizontalAlignment="Right">

                                <ComboBoxItem Content="Acrylic Blur" Tag="DimWithBlur"/>
                                <ComboBoxItem Content="Dim Background" Tag="DimOnly"/>
                                <ComboBoxItem Content="No Effects" Tag="None"/>

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyleB}">
                                        <Setter Property="Tag" Value="{Binding ItemTag}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13">
                        <Grid HorizontalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Blur Intensity" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Style="{StaticResource OptionNameText}"/>

                            <TextBlock Text="Set the blur intensity of the background overlay  (default: 20)" 
                                       Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Margin="15,0" Style="{StaticResource OptionDescText}"/>

                            <TextBox x:Name="InputBlurIntensity"
                                     MinWidth="125" Grid.Column="2"
                                     MinHeight="30" Padding="10,8"
                                     PreviewTextInput="NumberValidationTextBox"
                                     DataObject.Pasting="NumberPasteValidationTextBox"
                                     LostFocus="InputBlurIntensity_LostFocus"
                                     Style="{StaticResource TextBoxStyleB}"
                                     HorizontalAlignment="Right">

                                
                                
                            </TextBox>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13">
                        <Grid HorizontalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Dim Color" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Style="{StaticResource OptionNameText}"/>

                            <TextBlock Text="Set the dim color of the background overlay  (default: '080808')" 
                                       Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Margin="15,0" Style="{StaticResource OptionDescText}"/>

                            <TextBox x:Name="InputDimColor"
                                     MinWidth="125" Grid.Column="2"
                                     MinHeight="30" Padding="10,8"
                                     LostFocus="InputDimColor_LostFocus"
                                     Style="{StaticResource TextBoxStyleB}"
                                     HorizontalAlignment="Right">
                                
                                

                            </TextBox>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13">
                        <Grid HorizontalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Dim Intensity" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Style="{StaticResource OptionNameText}"/>

                            <TextBlock Text="Set the dim intensity of the background overlay  (default: 25)" 
                                       Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Margin="15,0" Style="{StaticResource OptionDescText}"/>

                            <TextBox x:Name="InputDimIntensity"
                                     MinWidth="125" Grid.Column="2"
                                     MinHeight="30" Padding="10,8"
                                     PreviewTextInput="NumberValidationTextBox"
                                     DataObject.Pasting="NumberPasteValidationTextBox"
                                     LostFocus="InputDimIntensity_LostFocus"
                                     Style="{StaticResource TextBoxStyleB}"
                                     HorizontalAlignment="Right">



                            </TextBox>
                        </Grid>
                    </Border>

                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
