<Window x:Class="ZennLauncherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZennLauncherApp"
        mc:Ignorable="d"
        Title="Zenn Launcher"
        MinWidth="1120" MinHeight="668"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      GlassFrameThickness="-1"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>

            <local:ProfileImageConverter x:Key="ProfileImgConv"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CustomResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <LinearGradientBrush.RelativeTransform>
                <TransformGroup>
                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                    <SkewTransform CenterX="0.5" CenterY="0.5"/>
                    <RotateTransform Angle="-41.82" CenterX="0.5" CenterY="0.5"/>
                    <TranslateTransform X="0.3" Y="0.3"/>
                </TransformGroup>
            </LinearGradientBrush.RelativeTransform>
            <GradientStop Color="#FF221E2D"/>
            <GradientStop Color="#FF251E39" Offset="0.898"/>
        </LinearGradientBrush>
    </Window.Background>

    <Border BorderThickness="2, 40, 2, 10">
        <Border.BorderBrush>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <LinearGradientBrush.RelativeTransform>
                    <TransformGroup>
                        <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                        <SkewTransform CenterX="0.5" CenterY="0.5"/>
                        <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#FF2A243B"/>
                <GradientStop Color="#FF2E2741" Offset="0.5"/>
                <GradientStop Color="#FF2A243B" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid x:Name="MainGrid">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>

            <Grid.Effect>
                <BlurEffect Radius="0"/>
            </Grid.Effect>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1"
                        Margin="0,-39,5,1" Style="{StaticResource WindowControlButtonAreaStyle}">

                <Button Content="—" Click="BtnMinimize_Click" Style="{StaticResource ControlButtonStyle}"
                        MinWidth="35" MinHeight="30" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="☐" Click="BtnMaximize_Click" Style="{StaticResource ControlButtonStyle}"
                        MinWidth="35" MinHeight="30" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Button Content="✕" Click="BtnClose_Click" Style="{StaticResource ControlButtonStyle}"
                        MinWidth="35" MinHeight="30" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="0"
                        Margin="30,-40,0,0" WindowChrome.IsHitTestVisibleInChrome="False" 
                        HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="0"
                        Grid.ColumnSpan="2" MinWidth="55" MinHeight="40">

                <TextBlock Text="ZENN" FontWeight="Bold" 
                           VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                           FontSize="17" Margin="0,0,0,5">
                    
                    <TextBlock.Foreground>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#A89083B3"/>
                            <GradientStop Color="#A8B6A0ED" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

            </StackPanel>

            <StackPanel x:Name="SidebarPanel" HorizontalAlignment="Left" 
                        Width="230" Grid.RowSpan="2" Grid.Column="0">

                <StackPanel.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF1A1820"/>
                        <GradientStop Color="#FF1A1820" Offset="1"/>
                    </LinearGradientBrush>
                </StackPanel.Background>

                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" 
                                         Value="Maximized">
                                <Setter Property="Margin" Value="5,0,0,0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button x:Name="BtnSidebarCollapse" HorizontalAlignment="Left"
                        FontFamily="./Assets/Fonts/#Font Awesome 7 Free" Content="&#xf0c9;" 
                        FontSize="16" FontWeight="Light" Padding="19,5" Margin="5,5"
                        Background="Transparent"
                        Click="BtnSidebarCollapse_Click">

                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle_Common}">

                        </Style>
                    </Button.Style>

                </Button>

                <ListBox x:Name="SidebarNavList"
                         SelectionChanged="SidebarNavList_SelectionChanged" 
                         Style="{StaticResource ListBoxStyle}" Width="Auto" 
                         Background="Transparent" BorderBrush="Transparent" 
                         Margin="5,0">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel x:Name="DisplayPanel" Orientation="Horizontal" Margin="0">

                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, ElementName=SidebarPanel}" Value="Collapsed">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="{Binding DisplayIcon}" 
                                           FontFamily="./Assets/Fonts/#Font Awesome 7 Free" 
                                           FontSize="16" 
                                           Width="30" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=SidebarPanel}" Value="Collapsed">
                                                    <Setter Property="Width" Value="Auto"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                                <TextBlock Text="{Binding DisplayName}" 
                                           FontFamily="Bahnschrift Light" 
                                           FontSize="15"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           x:Name="ItemText">
                                    
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=SidebarPanel}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemStyle_Primary}">
                            <Setter Property="Tag" Value="{Binding ItemTag}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

            </StackPanel>

            <ContentControl x:Name="ContentSlot" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>

            <Border Grid.Row="2" Grid.ColumnSpan="4" 
                    BorderThickness="0,0.9,0,0"
                    Margin="0,0,0,0">

                <Border.BorderBrush>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF332C48"/>
                        <GradientStop Color="#FF594D79" Offset="0.5"/>
                        <GradientStop Color="#FF332C48" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <DockPanel VerticalAlignment="Center" MinHeight="20" LastChildFill="False">
                    <DockPanel.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#FF2A243B"/>
                            <GradientStop Color="#FF2A243B" Offset="1"/>
                            <GradientStop Color="#FF2E2741" Offset="0.5"/>
                        </LinearGradientBrush>
                    </DockPanel.Background>

                    <StackPanel x:Name="StackPanelGamesBtns" DockPanel.Dock="Right" Orientation="Horizontal" 
                                Margin="0,0,25,0" Visibility="Collapsed">
                        <Button x:Name="BtnAddNewGame" Style="{StaticResource MenuButtonStyle_PrimaryA}" 
                                Content="✚  Add a Game" Click="BtnAddNewGame_Click" Margin="5,8"
                                FontFamily="Global User Interface" FontSize="13"/>
                    </StackPanel>

                    <StackPanel x:Name="StackPanelToolsBtns" DockPanel.Dock="Right" Orientation="Horizontal" 
                                Margin="0,0,25,0" Visibility="Collapsed">
                        <Button x:Name="BtnAddNewTool" Style="{StaticResource MenuButtonStyle_PrimaryA}" 
                                Content="✚  Add a Tool" Click="BtnAddNewTool_Click" Margin="5,8"
                                FontFamily="Global User Interface" FontSize="13"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="25,5,0,5" >
                        <Grid HorizontalAlignment="Right">

                            <ToggleButton x:Name="BtnProfileMenu" Tag="{Binding ProfileId}"
                                          Content="{Binding ProfileName, StringFormat='{}{0} ...'}"
                                          FontFamily="Global User Interface" FontSize="13" 
                                          BorderThickness="0" Padding="10">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonStyle_ProfileMenu}">
                     
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Popup IsOpen="{Binding IsChecked, ElementName=BtnProfileMenu}" 
                                   PlacementTarget="{Binding ElementName=BtnProfileMenu}"
                                   Placement="Top"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   HorizontalOffset="0"
                                   VerticalOffset="-5">

                                <Border Background="#F22B2245" 
                                        CornerRadius="5" 
                                        BorderBrush="#FF594D7B"
                                        BorderThickness="1"
                                        Width="300" Height="Auto"
                                        Margin="0,0,0,10">

                                    <DockPanel Margin="10" HorizontalAlignment="Stretch">
                                        <Grid>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>


                                            <StackPanel Grid.Row="0" Margin="10,5">
                                                <TextBlock Text="{Binding ProfileName}"
                                                           Foreground="White"
                                                           FontSize="17"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text=""
                                                           Foreground="WhiteSmoke"
                                                           Margin="0,5,0,5"
                                                           FontSize="11"
                                                           VerticalAlignment="Bottom">
                                            
                                                <Hyperlink Click="LinkProfileSettings_Click"
                                                           Style="{StaticResource HyperlinkStyle}">

                                                           Profile Settings
                                                </Hyperlink>

                                                </TextBlock>

                                            </StackPanel>

                                            <Border x:Name="ProfileMenuAvatar" 
                                                    Width="80" 
                                                    Height="80" 
                                                    BorderBrush="#70594D7B" 
                                                    BorderThickness="2"
                                                    Grid.Row="0"
                                                    Margin="5,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                                <Border.Background>
                                                    <ImageBrush>
                                                        <ImageBrush.ImageSource>
                                                            <Binding Path="ProfileId"  
                                                                     Converter="{StaticResource ProfileImgConv}"
                                                                     ConverterParameter="85">
                                                                <Binding.TargetNullValue>
                                                                    <BitmapImage UriSource="/default_avatar.jpg" 
                                                                                 DecodePixelWidth="85"
                                                                                 CacheOption="OnLoad"/>
                                                                </Binding.TargetNullValue>
                                                            </Binding>
                                                        </ImageBrush.ImageSource>
                                                    </ImageBrush>
                                                </Border.Background>
                                            </Border>


                                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                <Separator VerticalAlignment="Bottom"
                                                           Margin="0,5,0,10"
                                                           Background="#55594D7B"/>
                                                <Button x:Name="BtnSettings"
                                                        Style="{StaticResource MenuButtonStyle_Popup}"
                                                        Content="Settings"
                                                        Click="BtnSettings_Click"
                                                        MinHeight="35"/>
                                                <Button x:Name="BtnLogOut"
                                                        Style="{StaticResource MenuButtonStyle_Popup}"
                                                        Content="Sign out"
                                                        Click="BtnLogOut_Click"
                                                        MinHeight="35"/>
                                            </StackPanel>

                                        </Grid>


                                    </DockPanel>

                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                    
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Panel.ZIndex="99" Visibility="Collapsed"
                    BorderThickness="3" MaxWidth="25" Margin="0,-3,0,0">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterX="0.5" CenterY="0.5"/>
                                <RotateTransform Angle="270" CenterX="0.5" CenterY="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#25000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Panel.ZIndex="99" Visibility="Collapsed"
                    BorderThickness="3" MaxWidth="25" Margin="0,-3,0,0">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterX="0.5" CenterY="0.5"/>
                                <RotateTransform Angle="270" CenterX="0.5" CenterY="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#25000000" Offset="1"/>
                        <GradientStop Color="#00000000" Offset="0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="4" Panel.ZIndex="99" BorderThickness="3"
                     MaxHeight="25" Margin="0,-68,-2,0" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#35000000" Offset="1"/>
                        <GradientStop Color="#00000000" Offset="0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border x:Name="BlackOverlay" Grid.ColumnSpan="4" Grid.RowSpan="3" Background="#00000000"
                    Margin="0,-39,0,-10" IsHitTestVisible="False"/>
            
        </Grid>
    </Border>
</Window>
