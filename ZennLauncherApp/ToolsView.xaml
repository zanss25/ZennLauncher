<UserControl x:Class="ZennLauncherApp.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZennLauncherApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <ResourceDictionary>
            
            <local:PathToImageConverter x:Key="ImageConverter"/>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CustomResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ContentViewer" Grid.RowSpan="2" VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="80,85,80,68">
                <ItemsControl x:Name="ContainerBtnTools">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12">
                                <Button Width="149" Height="223" 
                                        BorderBrush="#00000000"
                                        Foreground="WhiteSmoke"
                                        Style="{StaticResource CoverButtonStyle}"
                                        MouseDoubleClick="BtnTools_MouseDoubleClick"
                                        Tag="{Binding}"
                                        Cursor="Hand">

                                    <Button.Background>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#FF342C49"/>
                                            <GradientStop Color="#FF342C49" Offset="1"/>
                                            <GradientStop Color="#FF403659" Offset="0.5"/>
                                        </LinearGradientBrush>
                                    </Button.Background>

                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource ContextMenuStyle}">
                                            
                                            <MenuItem Header="Edit Properties" 
                                                      Click="MenuItemEdit_Click"
                                                      Tag="{Binding}"
                                                      Style="{StaticResource ContextMenuItemStyle}"/>

                                            <MenuItem Header="Open File Location" 
                                                      Click="MenuOpenDir_Click"
                                                      Tag="{Binding}"
                                                      Style="{StaticResource ContextMenuItemStyle}"/>

                                            <Separator Style="{StaticResource ContextMenuSeparatorStyle}"/>
                                            <MenuItem Header="Delete Tool" 
                                                      Foreground="#FFFF3F3F" 
                                                      Click="MenuItemDelete_Click" 
                                                      Tag="{Binding}"
                                                      Style="{StaticResource ContextMenuItemStyle}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>

                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                            <Image Source="{Binding ToolIconPath, Converter={StaticResource ImageConverter}}" 
                                                   Width="92" 
                                                   Height="92" />
                                            
                                            <TextBlock Text="{Binding ToolTitle}"
                                                   FontSize="12"
                                                   Margin="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="WhiteSmoke" />

                                        </StackPanel>

                                        <Image Source="{Binding ToolCoverPath}" 
                                               Width="149" 
                                               Height="223" 
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <DockPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.Row="0" MinHeight="70" 
                   MaxHeight="100" Margin="0,-2,0,0">

            <DockPanel.Effect>
                <BlurEffect/>
            </DockPanel.Effect>

            <DockPanel.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#00161616" Offset="1"/>
                    <GradientStop Color="#FF342D47" Offset="0"/>
                </LinearGradientBrush>
            </DockPanel.Background>

        </DockPanel>

        <DockPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.Row="0" MinHeight="35" 
       MaxHeight="100" Background="#BF372D51" Margin="32,15,32,10">

            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <Grid>
                    <TextBox  x:Name="SearchBarTools" 
                              TextChanged="SearchBarTools_Changed" 
                              MinWidth="280" 
                              VerticalContentAlignment="Center" 
                              Height="25" Margin="10,7,10,7" 
                              Padding="5,0,0,0"
                              Style="{StaticResource TextBoxStyle}"/>
                    
                    <TextBlock IsHitTestVisible="False" 
                               Text="Search tools..." 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Left" 
                               Margin="20,0,0,0" 
                               Foreground="#50FFFFFF">
                        
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBarTools}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        
                    </TextBlock>
                </Grid>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                <TextBlock Text="Sort by" Margin="10,10,0,10" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <ComboBox x:Name="ComboSortByTools" 
                          Width="125" Margin="10,7,10,7" 
                          Style="{StaticResource ComboBoxStyle}"
                          SelectionChanged="ComboSortByTools_Changed"
                          SelectedIndex="0" MinHeight="25">

                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF272237" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF272237" />
                    </ComboBox.Resources>

                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}">
                            <Setter Property="Tag" Value="{Binding SortBy}"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>

                </ComboBox>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
