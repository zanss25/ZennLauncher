<Application x:Class="ZennLauncherApp.App" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZennLauncherApp">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ColorScheme.xaml"/>
                <ResourceDictionary Source="CustomResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:PathToImageConverter x:Key="ImageConverter"/>
            <local:ProfileImageConverter x:Key="ProfileImgConv"/>
        </ResourceDictionary>
    </Application.Resources>
    
</Application>
