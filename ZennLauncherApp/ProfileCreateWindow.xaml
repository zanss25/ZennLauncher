
<Window x:Class="ZennLauncherApp.ProfileCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZennLauncherApp"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Create New Profile" Height="410" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush_1}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                  GlassFrameThickness="5" 
                  CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

    </Window.Resources>

    <Border BorderThickness="2, 40, 2, 2">
        <Border.BorderBrush>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <LinearGradientBrush.RelativeTransform>
                    <TransformGroup>
                        <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                        <SkewTransform CenterX="0.5" CenterY="0.5"/>
                        <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#FF2A243B"/>
                <GradientStop Color="#FF2E2741" Offset="0.5"/>
                <GradientStop Color="#FF2A243B" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>


        <Grid Margin="5,0,5,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="370"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource WindowControlButtonAreaStyle}">

                <Button Content="✕" Click="BtnClose_Click" Style="{StaticResource ControlButtonStyle}"
                    MinWidth="35" MinHeight="30" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" 
                    VerticalAlignment="Center"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="0"
                        Margin="20,-40,0,0" WindowChrome.IsHitTestVisibleInChrome="False" 
                        HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="0"
                        MinWidth="55" MinHeight="40">

                <TextBlock x:Name="TitleTextBlock" Text="CREATE NEW PROFILE" 
                           VerticalAlignment="Center" HorizontalAlignment="Center" 
                           Foreground="#7FC9B5FF" FontWeight="Bold" FontSize="15" />

            </StackPanel>

            <StackPanel Margin="10,10,10,0" Grid.Row="1">
                <TextBlock Text="PROFILE NAME" Padding="10" Foreground="#A89A8FB9" FontWeight="Bold"/>

                <Grid Margin="10,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Name="InputProfileName" 
                         Grid.Column="0"
                         Style="{StaticResource TextBoxStyleB}"
                         Padding="5,0,0,0"/>

                </Grid>
            </StackPanel>

            <StackPanel x:Name="PasswordStackPanel" Margin="10,0,10,0" Grid.Row="2" Visibility="Visible">
                <TextBlock Text="PASSWORD" Padding="10" Foreground="#A89A8FB9" FontWeight="Bold"/>
                <Grid Margin="10,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox Name="InputProfilePass"
                                 PasswordChar="●"
                                 Grid.Column="0"
                                 Padding="5,0,0,0">

                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox" BasedOn="{StaticResource PasswordBoxStyleB}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=CheckBoxDontUsePass}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>

                    </PasswordBox>

                </Grid>
            </StackPanel>

            <StackPanel x:Name="ConfirmPasswordStackPanel" Margin="10,0,10,0" Grid.Row="3" Visibility="Visible">
                <TextBlock Text="CONFIRM PASSWORD" Padding="10" Foreground="#A89A8FB9" FontWeight="Bold"/>
                <Grid Margin="10,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox Name="InputConfirmPass" 
                                 PasswordChar="●"
                                 Grid.Column="0"
                                 Padding="5,0,0,0">

                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox" BasedOn="{StaticResource PasswordBoxStyleB}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=CheckBoxDontUsePass}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>

                    </PasswordBox>

                </Grid>

                <CheckBox x:Name="CheckBoxDontUsePass" Content="Don't use password" Visibility="Visible"
                          Style="{StaticResource CheckBoxStyle}"
                          Grid.Column="0" Margin="10,15" Foreground="#CCFFFFFF"/>

            </StackPanel>

            <DockPanel x:Name="BottomStackPanel" Margin="10,10,10,0" Grid.Row="4">
                <Button x:Name="BtnCreateProfile" Content="Create" Click="BtnCreateProfile_Click" 
                        Style="{StaticResource MenuButtonStyle_Primary}" HorizontalAlignment="Left" 
                        Margin="10,10,10,25" Padding="15,8,15,8" MinWidth="125" BorderThickness="0,0,0,0"
                        FontFamily="Global Sans Serif" FontSize="12" VerticalAlignment="Bottom"
                        IsDefault="True"/>
            </DockPanel>

            <DockPanel Margin="10,10,20,0" Grid.RowSpan="4" Grid.Column="1">
                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text=" " Padding="6" Foreground="#A89A8FB9" FontWeight="Bold"/>
                    <Border x:Name="PreviewAvatar" 
                            Width="80" 
                            Height="80" 
                            BorderBrush="#70594D7B" 
                            BorderThickness="2">
                        <Border.Background>
                            <ImageBrush>
                                <ImageBrush.ImageSource>
                                    <BitmapImage UriSource="/default_avatar.jpg"
                                                 DecodePixelWidth="85"
                                                 CacheOption="OnLoad"/>
                                </ImageBrush.ImageSource>
                            </ImageBrush>
                        </Border.Background>

                    </Border>

                    <Button x:Name="BtnChangeAvatar" Content="Change" Click="BtnChangeAvatar_Click" 
                            Style="{StaticResource MenuButtonStyle_Common}" Margin="0,10,0,5" Padding="8" 
                            FontFamily="Global Sans Serif" FontSize="13" BorderThickness="0,0,0,0"/>
                    <Button x:Name="BtnResetAvatar" Content="Reset" Click="BtnResetAvatar_Click" 
                            Style="{StaticResource MenuButtonStyle_Common}" Margin="0,0,0,10" Padding="8"
                            FontFamily="Global Sans Serif" FontSize="13" BorderThickness="0,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
