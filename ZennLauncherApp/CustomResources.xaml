                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource BtnDisabledBrush}"/>
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource BtnDisabledBorderBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextCommonDisabledBrush}"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
