<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ZennLauncherApp">

    <local:ProfileImageConverter x:Key="ProfileImgConv"/>
    
    <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontTitle}"/>
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,1,0,0" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" 
                     Value="Maximized">
                <Setter Property="Margin" Value="0,6,0,0" />
            </DataTrigger>

            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" 
                     Value="Normal">
                <Setter Property="Margin" Value="0,1,0,0" />
            </DataTrigger>
        </Style.Triggers>

    </Style>

    <Style x:Key="WindowControlButtonAreaStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" 
                     Value="Normal">
                <Setter Property="Margin" Value="0,-40,0,1" />
            </DataTrigger>

            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" 
                     Value="Maximized">
                <Setter Property="Margin" Value="0,-39,0,1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ControlButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#00000000"/>
        <Setter Property="Foreground" Value="#D8E1E1E1"/>
        <Setter Property="BorderBrush" Value="#00000000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    
                    <Border x:Name="MainBorder" 
                            Background="{TemplateBinding Background}"
                            CornerRadius="4" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="#AA3D3454"/>
                            <Setter Property="Foreground" Value="#FFF5F5F5"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="#803D3454"/>
                            <Setter Property="Foreground" Value="#FFF5F5F5"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
                
            </Setter.Value>
        </Setter>
    </Style>

