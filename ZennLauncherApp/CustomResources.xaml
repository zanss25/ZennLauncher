                    <GradientStop Color="#FF342C49" Offset="1"/>
                    <GradientStop Color="#FF403659" Offset="0.5"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource TextCommonActiveBrush}"/>
        <Setter Property="BorderBrush" Value="#FF221E2F"/>
