    <Style x:Key="ToggleButtonStyle_ProfileMenu" TargetType="ToggleButton">
        <Setter Property="Background" Value="#00221E2F"/>
        <Setter Property="Foreground" Value="{StaticResource TextCommonBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSidebar}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">

                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ProfileAvatar" 
                                BorderBrush="#70594D7B" 
                                BorderThickness="1.5" CornerRadius="4"
                                MinHeight="40" MinWidth="40" Margin="0,0,0,0">

                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill">
                                    <ImageBrush.ImageSource>
                                        <!-- Kuncinya di RelativeSource TemplatedParent -->
                                        <Binding Path="Tag" 
                                                 RelativeSource="{RelativeSource TemplatedParent}"
                                                 Converter="{StaticResource ProfileImgConv}"
                                                 ConverterParameter="40">
                                            <Binding.TargetNullValue>
                                                <BitmapImage UriSource="/default_avatar.jpg" 
                                                             DecodePixelWidth="40" 
                                                             CacheOption="OnLoad"/>
                                            </Binding.TargetNullValue>
                                        </Binding>
                                    </ImageBrush.ImageSource>
                                </ImageBrush>
                            </Border.Background>

                        </Border>

                        <Border x:Name="MainBorder" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="#00000000"
                                BorderThickness="0.7"
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border>
                            <Path x:Name="ArrowUp"
                                  Stroke="{StaticResource TextCommonBrush}"
                                  Fill="{StaticResource TextCommonBrush}"
                                  StrokeThickness="1" 
                                  VerticalAlignment="Center"
                                  Data="M 0.6,4 L 6,4 L 3.36,0.6 Z"
                                  Margin="-2,0,0,2"/>
                        </Border>
                    </StackPanel>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="#003D3454"/>
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="#00594D7B"/>
                            <Setter Property="Foreground" Value="{StaticResource TextCommonActiveBrush}"/>
                            <Setter TargetName="ArrowUp" Property="Stroke" Value="{StaticResource TextCommonActiveBrush}"/>
                            <Setter TargetName="ArrowUp" Property="Fill" Value="{StaticResource TextCommonActiveBrush}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="#00221E2C"/>
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="#00594D7B"/>
                            <Setter Property="Foreground" Value="{StaticResource TextCommonPressedBrush}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="#00211739"/>
