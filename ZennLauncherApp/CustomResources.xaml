                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource BtnPrimaryBorderPressedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextCommonPressedBrush}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
