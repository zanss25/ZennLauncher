                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource BtnCommonHoverBrush}"/>
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource BtnCommonBorderHoverBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource BtnDisabledBrush}"/>
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource BtnDisabledBorderBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextCommonDisabledBrush}"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource BtnCommonPressedBrush}"/>
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource BtnCommonBorderPressedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextCommonPressedBrush}"/>
                        </Trigger>
                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
                
            </Setter.Value>
        </Setter>
    </Style>

