            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    
                    <Border x:Name="MainBorder" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BtnCommonBorderBrush}"
                            BorderThickness="0.7"
                            CornerRadius="4" 
                            Padding="{TemplateBinding Padding}">
