<UserControl x:Class="ZennLauncherApp.FoldersSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZennLauncherApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
      
    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ContentViewer" Grid.Row="1" HorizontalAlignment="Stretch"
                  VerticalScrollBarVisibility="Auto">

            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SimpleScrollBarEdge}"/>
            </ScrollViewer.Resources>

            <StackPanel Margin="20,5">

                <ItemsControl x:Name="ContainerFoldersSettings">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <Grid Grid.Row="0" MinHeight="70" VerticalAlignment="Top">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Folders"
                                   Grid.Column="1" Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SettingsTitleText}" 
                                   HorizontalAlignment="Left"/>

                    </Grid>

                    <Border BorderBrush="{StaticResource BorderCommonBrush}" BorderThickness="0,1,0,0" Padding="0,13" Margin="0,0,0,5">
                        <Grid HorizontalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="32"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Games Default Directory" Grid.Column="0" Grid.Row="0" Margin="0,0,0,10"
                                       VerticalAlignment="Center" Style="{StaticResource OptionNameText}"/>

                            <TextBlock Text="Set the default folder directory when selecting games executable" 
                                       Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0"  HorizontalAlignment="Stretch" 
                                       VerticalAlignment="Center" Margin="15,0,0,10" 
                                       Style="{StaticResource OptionDescText}"/>

                            <TextBox x:Name="InputGamesDefaultDir"
                                     MinWidth="125" Grid.ColumnSpan="2" Grid.Row="2"
                                     LostFocus="InputGamesDefaultDir_LostFocus"
                                     Style="{StaticResource TextBoxStyleB}"
                                     Padding="5,0,0,0"/> 

                            <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal">

                                <Button x:Name="BtnBrowseGamesDefaultDir" 
                                        Grid.Column="2" Grid.Row="2"
                                        Content="Browse" 
                                        FontSize="13"
                                        Style="{StaticResource MenuButtonStyle_Common}"
                                        Click="BtnBrowseGamesDefaultDir_Click" 
                                        Margin="6,0,0,0" 
                                        Padding="15,0,15,0" 
                                        Height="30"
                                        BorderThickness="1"/>

                                <Button x:Name="BtnResetGamesDefaultDir" 
                                        Grid.Column="2" Grid.Row="2"
                                        Content="Reset" 
                                        FontSize="13"
                                        Style="{StaticResource MenuButtonStyle_Common}"
                                        Click="BtnResetGamesDefaultDir_Click" 
                                        Margin="6,0,0,0" 
                                        Padding="15,0,15,0" 
                                        Height="30"
                                        BorderThickness="1"/>

                            </StackPanel>

                        </Grid>
                    </Border>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13" Margin="0,0,0,5">
                        <Grid HorizontalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="32"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Tools Default Directory" Grid.Column="0" Grid.Row="0" Margin="0,0,0,10"
                                       VerticalAlignment="Center" Style="{StaticResource OptionNameText}"/>

                            <TextBlock Text="Set the default folder directory when selecting tools executable" 
                                       Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" HorizontalAlignment="Stretch" 
                                       VerticalAlignment="Center" Margin="15,0,0,10" 
                                       Style="{StaticResource OptionDescText}"/>

                            <TextBox x:Name="InputToolsDefaultDir"
                                     MinWidth="125" Grid.ColumnSpan="2" Grid.Row="2"
                                     LostFocus="InputToolsDefaultDir_LostFocus"
                                     Style="{StaticResource TextBoxStyleB}"
                                     Padding="5,0,0,0"/>

                            <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal">

                                <Button x:Name="BtnBrowseToolsDefaultDir" 
                                        Grid.Column="2" Grid.Row="2"
                                        Content="Browse" 
                                        FontSize="13"
                                        Style="{StaticResource MenuButtonStyle_Common}"
                                        Click="BtnBrowseToolsDefaultDir_Click" 
                                        Margin="6,0,0,0" 
                                        Padding="15,0,15,0" 
                                        Height="30"
                                        BorderThickness="1"/>

                                <Button x:Name="BtnResetToolsDefaultDir" 
                                        Grid.Column="2" Grid.Row="2"
                                        Content="Reset" 
                                        FontSize="13"
                                        Style="{StaticResource MenuButtonStyle_Common}"
                                        Click="BtnResetToolsDefaultDir_Click" 
                                        Margin="6,0,0,0" 
                                        Padding="15,0,15,0" 
                                        Height="30"
                                        BorderThickness="1"/>

                            </StackPanel>

                        </Grid>
                    </Border>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13" Margin="0,0,0,5">
                        <Grid HorizontalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="32"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Icons Default Directory" Grid.Column="0" Grid.Row="0" Margin="0,0,0,10"
                                       VerticalAlignment="Center" Style="{StaticResource OptionNameText}"/>

                            <TextBlock Text="Set the default folder directory when selecting icon files" 
                                       Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" HorizontalAlignment="Stretch" 
                                       VerticalAlignment="Center" Margin="15,0,0,10" 
                                       Style="{StaticResource OptionDescText}"/>

                            <TextBox x:Name="InputIconsDefaultDir"
                                     MinWidth="125" Grid.ColumnSpan="2" Grid.Row="2"
                                     LostFocus="InputIconsDefaultDir_LostFocus"
                                     Style="{StaticResource TextBoxStyleB}"
                                     Padding="5,0,0,0"/>
                            <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal">

                                <Button x:Name="BtnBrowseIconsDefaultDir" 
                                        Grid.Column="2" Grid.Row="2"
                                        Content="Browse" 
                                        FontSize="13"
                                        Style="{StaticResource MenuButtonStyle_Common}"
                                        Click="BtnBrowseIconsDefaultDir_Click" 
                                        Margin="6,0,0,0" 
                                        Padding="15,0,15,0" 
                                        Height="30"
                                        BorderThickness="1"/>

                                <Button x:Name="BtnResetIconsDefaultDir" 
                                        Grid.Column="2" Grid.Row="2"
                                        Content="Reset" 
                                        FontSize="13"
                                        Style="{StaticResource MenuButtonStyle_Common}"
                                        Click="BtnResetIconsDefaultDir_Click" 
                                        Margin="6,0,0,0" 
                                        Padding="15,0,15,0" 
                                        Height="30"
                                        BorderThickness="1"/>

                            </StackPanel>

                        </Grid>
                    </Border>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13" Margin="0,0,0,5">
                        <Grid HorizontalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="32"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Cover Grids Default Directory" Grid.Column="0" Grid.Row="0" Margin="0,0,0,10"
                                       VerticalAlignment="Center" Style="{StaticResource OptionNameText}"/>

                            <TextBlock Text="Set the default folder directory when selecting cover grid files" 
                                       Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" HorizontalAlignment="Stretch" 
                                       VerticalAlignment="Center" Margin="15,0,0,10" 
                                       Style="{StaticResource OptionDescText}"/>

                            <TextBox x:Name="InputCoversDefaultDir"
                                     MinWidth="125" Grid.ColumnSpan="2" Grid.Row="2"
                                     LostFocus="InputCoversDefaultDir_LostFocus"
                                     Style="{StaticResource TextBoxStyleB}"
                                     Padding="5,0,0,0"/>

                            <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal">

                                <Button x:Name="BtnBrowseCoversDefaultDir" 
                                        Grid.Column="2" Grid.Row="2"
                                        Content="Browse" 
                                        FontSize="13"
                                        Style="{StaticResource MenuButtonStyle_Common}"
                                        Click="BtnBrowseCoversDefaultDir_Click" 
                                        Margin="6,0,0,0" 
                                        Padding="15,0,15,0" 
                                        Height="30"
                                        BorderThickness="1"/>

                                <Button x:Name="BtnResetCoversDefaultDir" 
                                        Grid.Column="2" Grid.Row="2"
                                        Content="Reset" 
                                        FontSize="13"
                                        Style="{StaticResource MenuButtonStyle_Common}"
                                        Click="BtnResetCoversDefaultDir_Click" 
                                        Margin="6,0,0,0" 
                                        Padding="15,0,15,0" 
                                        Height="30"
                                        BorderThickness="1"/>

                            </StackPanel>

                        </Grid>
                    </Border>

                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
