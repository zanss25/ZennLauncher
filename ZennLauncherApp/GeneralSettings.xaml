<UserControl x:Class="ZennLauncherApp.GeneralSettingsView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZennLauncherApp" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CustomResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ContentViewer" Grid.Row="1" HorizontalAlignment="Stretch"
                  VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="20,5">

                <ItemsControl x:Name="ContainerGeneralSettings">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <Grid Grid.Row="0" MinHeight="70" VerticalAlignment="Top">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>



                        <TextBlock Text="General"
                                   Grid.Column="1" Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Foreground="WhiteSmoke"
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Left"/>

                    </Grid>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Default Starting View" Grid.Column="0" 
                                       VerticalAlignment="Center" Foreground="#BBFFFFFF"/>

                            <TextBlock Text="Choose which tab is displayed when the launcher starts" Grid.Column="1"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Margin="15,0" Foreground="#55FFFFFF"/>

                            <ComboBox x:Name="ComboDefaultStartingTab"
                                      MinWidth="125" Grid.Column="2"
                                      MinHeight="30" Padding="10,8"
                                      Style="{StaticResource ComboBoxStyleB}"
                                      SelectionChanged="ComboDefaultStartingTab_Changed"
                                      Background="#31A896DD" BorderBrush="#FF594D7B" 
                                      HorizontalAlignment="Right">

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyleB}">
                                        <Setter Property="Tag" Value="{Binding ItemTag}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Default Games Sort Option" Grid.Column="0" 
                                       VerticalAlignment="Center" Foreground="#BBFFFFFF"/>

                            <TextBlock Text="Set games default sorting method (e.g., Alphabetical)" Grid.Column="1"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Margin="15,0" Foreground="#55FFFFFF"/>

                            <ComboBox x:Name="ComboGamesSortOption"
                                      MinWidth="125" Grid.Column="2"
                                      MinHeight="30" Padding="10,8"
                                      Style="{StaticResource ComboBoxStyleB}"
                                      SelectionChanged="ComboGamesSortOption_Changed"
                                      Background="#31A896DD" BorderBrush="#FF594D7B" 
                                      HorizontalAlignment="Right">

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyleB}">
                                        <Setter Property="Tag" Value="{Binding SortByTag}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                            </ComboBox>

                        </Grid>
                    </Border>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Default Tools Sort Option" Grid.Column="0" 
                                       VerticalAlignment="Center" Foreground="#BBFFFFFF"/>

                            <TextBlock Text="Set tools default sorting method (e.g., Alphabetical)" Grid.Column="1"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Margin="15,0" Foreground="#55FFFFFF"/>

                            <ComboBox x:Name="ComboToolsSortOption"
                                      MinWidth="125" Grid.Column="2"
                                      MinHeight="30" Padding="10,8"
                                      Style="{StaticResource ComboBoxStyleB}"
                                      SelectionChanged="ComboToolsSortOption_Changed"
                                      Background="#31A896DD" BorderBrush="#FF594D7B" 
                                      HorizontalAlignment="Right">

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyleB}">
                                        <Setter Property="Tag" Value="{Binding SortByTag}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                            </ComboBox>

                        </Grid>
                    </Border>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Games Post-Launch Action" Grid.Column="0" 
                                       VerticalAlignment="Center" Foreground="#BBFFFFFF"/>

                            <TextBlock Text="Set the launcher’s visibility once a game is running" Grid.Column="1"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Margin="15,0" Foreground="#55FFFFFF"/>

                            <ComboBox x:Name="ComboGamesLaunch"
                                      MinWidth="125" Grid.Column="2"
                                      MinHeight="30" Padding="10,8"
                                      Style="{StaticResource ComboBoxStyleB}"
                                      SelectionChanged="ComboGamesLaunch_Changed"
                                      Background="#31A896DD" BorderBrush="#FF594D7B" 
                                      HorizontalAlignment="Right">

                                <ComboBoxItem Content="Hide to Background" Tag="HideLauncher"/>
                                <ComboBoxItem Content="Close the Launcher" Tag="CloseLauncher"/>
                                <ComboBoxItem Content="Keep Launcher Open" Tag="DoNothing"/>

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyleB}">

                                    </Style>
                                </ComboBox.ItemContainerStyle>

                            </ComboBox>
                            
                        </Grid>
                    </Border>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Tools Post-Launch Action" Grid.Column="0" 
                                       VerticalAlignment="Center" Foreground="#BBFFFFFF"/>

                            <TextBlock Text="Set the launcher’s visibility once a tool is running" Grid.Column="1"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Margin="15,0" Foreground="#55FFFFFF"/>

                            <ComboBox x:Name="ComboToolsLaunch"
                                      MinWidth="125" Grid.Column="2"
                                      MinHeight="30" Padding="10,8"
                                      Style="{StaticResource ComboBoxStyleB}"
                                      SelectionChanged="ComboToolsLaunch_Changed"
                                      Background="#31A896DD" BorderBrush="#FF594D7B" 
                                      HorizontalAlignment="Right">

                                <ComboBoxItem Content="Hide to Background" Tag="HideLauncher"/>
                                <ComboBoxItem Content="Close the Launcher" Tag="CloseLauncher"/>
                                <ComboBoxItem Content="Keep Launcher Open" Tag="DoNothing"/>

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyleB}">

                                    </Style>
                                </ComboBox.ItemContainerStyle>

                            </ComboBox>
                            
                        </Grid>
                    </Border>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,13">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Startup on Windows Login" Grid.Column="0" 
                                       VerticalAlignment="Center" Foreground="#BBFFFFFF"/>

                            <TextBlock Text="Automatically start the launcher at Windows login" Grid.Column="1"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Margin="15,0" Foreground="#55FFFFFF"/>

                            <CheckBox x:Name="CheckBoxStartupOnWindows" Content="" 
                                      Grid.Column="2" MaxHeight="30" Padding="10,8"
                                      Click="CheckBoxStartupOnWindows_Click"
                                      Style="{StaticResource CheckBoxStyle}"
                                      Foreground="#CCFFFFFF"  HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
