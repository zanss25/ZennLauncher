<UserControl x:Class="ZennLauncherApp.BoardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZennLauncherApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

    </UserControl.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.ColumnSpan="3" Grid.Row="0"
                   MinHeight="70" MaxHeight="100" Margin="0,-2,0,0" IsHitTestVisible="False">

            <DockPanel.Effect>
                <BlurEffect/>
            </DockPanel.Effect>

            <DockPanel.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#00161616" Offset="1"/>
                    <GradientStop Color="{StaticResource BarBackGradient}" Offset="0"/>
                </LinearGradientBrush>
            </DockPanel.Background>

        </DockPanel>

        <Grid Margin="22,16,0,14" Grid.Column="0" Grid.RowSpan="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="SidebarA"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.Row="0" 
                    MinWidth="200" MaxWidth="200" Margin="0" CornerRadius="6" 
                    MinHeight="43" MaxHeight="100" BorderThickness="0.5"
                    Background="{StaticResource BarBackgroundBrush}"  
                    BorderBrush="{StaticResource BarBorderBrush}">

                <DockPanel>

                    <TextBlock FontFamily="{StaticResource FontPrimary}" 
                       Text="Stats" FontSize="18"
                       Foreground="{StaticResource TextCommonBrush}" 
                       VerticalAlignment="Center"
                       Margin="15,0" />

                </DockPanel>

            </Border>

            <Border x:Name="BoardA"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" 
                    Grid.ColumnSpan="2" Grid.Row="1" MinWidth="200" Margin="0,10,0,0" 
                    CornerRadius="6" BorderThickness="1">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7719171f" Offset="0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#CC342D47" Offset="0"/>
                        <GradientStop Color="#CC342D47" Offset="0.1"/>
                        <GradientStop Color="#DD453C5F" Offset="0.5"/>
                        <GradientStop Color="#CC342D47" Offset="0.9"/>
                        <GradientStop Color="#CC342D47" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

            </Border>

        </Grid>

        <Grid Margin="14,16,0,14" Grid.Column="1" Grid.RowSpan="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border VerticalAlignment="Top" 
                    MinHeight="43" MaxHeight="100" Margin="0" CornerRadius="6" 
                    Background="{StaticResource BarBackgroundBrush}" BorderThickness="0.5" 
                    BorderBrush="{StaticResource BarBorderBrush}" Grid.ColumnSpan="2">

                <DockPanel>

                    <TextBlock FontFamily="{StaticResource FontPrimary}" 
                               Text="Most Played" FontSize="18"
                               Foreground="{StaticResource TextCommonBrush}" 
                               VerticalAlignment="Center"
                               Margin="15,0" />

                </DockPanel>
            </Border>

            <Border x:Name="BoardBA"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" 
                    Grid.ColumnSpan="2" Grid.Row="1" MinWidth="200" Margin="0,10,0,0" 
                    CornerRadius="6" BorderThickness="1">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7719171f" Offset="0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#CC342D47" Offset="0"/>
                        <GradientStop Color="#CC342D47" Offset="0.1"/>
                        <GradientStop Color="#DD453C5F" Offset="0.5"/>
                        <GradientStop Color="#CC342D47" Offset="0.9"/>
                        <GradientStop Color="#CC342D47" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

            </Border>

            <Border x:Name="BoardBB"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" 
                    Grid.ColumnSpan="2" Grid.Row="2" MinWidth="200" Margin="0,10,0,0" 
                    CornerRadius="6" BorderThickness="1">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7719171f" Offset="0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#CC342D47" Offset="0"/>
                        <GradientStop Color="#CC342D47" Offset="0.1"/>
                        <GradientStop Color="#DD453C5F" Offset="0.5"/>
                        <GradientStop Color="#CC342D47" Offset="0.9"/>
                        <GradientStop Color="#CC342D47" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

            </Border>

        </Grid>

        <Grid Margin="14,16,22,14" Grid.Column="3" Grid.RowSpan="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="SidebarC"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.Row="0" 
                    MinWidth="200" MaxWidth="200" Margin="0" CornerRadius="6" 
                    MinHeight="43" MaxHeight="100" BorderThickness="0.5"
                    Background="{StaticResource BarBackgroundBrush}"  
                    BorderBrush="{StaticResource BarBorderBrush}">

                <DockPanel>

                    <TextBlock FontFamily="{StaticResource FontPrimary}" 
               Text="Boards" FontSize="18"
               Foreground="{StaticResource TextCommonBrush}" 
               VerticalAlignment="Center"
               Margin="15,0" />

                </DockPanel>

            </Border>

            <Border x:Name="BoardC"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch" 
            Grid.ColumnSpan="2" Grid.Row="1" MinWidth="200" Margin="0,10,0,0" 
            CornerRadius="6" BorderThickness="1">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7719171f" Offset="0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#CC342D47" Offset="0"/>
                        <GradientStop Color="#CC342D47" Offset="0.1"/>
                        <GradientStop Color="#DD453C5F" Offset="0.5"/>
                        <GradientStop Color="#CC342D47" Offset="0.9"/>
                        <GradientStop Color="#CC342D47" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

            </Border>

        </Grid>

    </Grid>
</UserControl>
